# ==============================================================================
# Variáveis de Ambiente - PoC Auditoria Contínua & CDC (TCC)
# ==============================================================================

# --- Topologia de Rede Proxmox (vmbr0) ---
SUBNET_CIDR=192.168.1.0/24
GATEWAY_IP=192.168.1.1
DNS_SERVER=192.168.1.1

# IPs dos Contêineres LXC
LXC_101_IP=192.168.1.110
LXC_102_IP=192.168.1.120
LXC_103_IP=192.168.1.130

# --- LXC 101: Origem Transacional (PostgreSQL) ---
POSTGRES_HOST=192.168.1.110
POSTGRES_PORT=5432
POSTGRES_DB=gestao_publica
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pwd
POSTGRES_REPLICATION_USER=debezium
POSTGRES_REPLICATION_PASSWORD=dbz_secure_pwd

# --- LXC 102: Ingestão e Processamento (Kafka & Spark) ---
ZOOKEEPER_PORT=2181
KAFKA_HOST=192.168.1.120
KAFKA_PORT=9092
DEBEZIUM_PORT=8083
SPARK_MASTER_HOST=192.168.1.120
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=8G

# --- LXC 103: Persistência (MinIO, HDFS, NFS) ---
# MinIO (S3 API)
MINIO_HOST=192.168.1.130
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin_lakehouse
MINIO_ROOT_PASSWORD=lakehouse_secret_key
MINIO_BUCKET_NAME=lakehouse-audit

# Hadoop HDFS
HDFS_NAMENODE_HOST=192.168.1.130
HDFS_NAMENODE_PORT=9000
HDFS_NAMENODE_WEBUI=9870

# NFS Storage
NFS_SERVER_HOST=192.168.1.130
NFS_EXPORT_PATH=/data/lakehouse-nfs
NFS_MOUNT_LOCAL=/mnt/lakehouse-nfs
